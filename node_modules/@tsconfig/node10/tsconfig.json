{
  "$schema": "https://www.schemastore.org/tsconfig",

  "compilerOptions": {
    "lib": ["es2018"],
    "module": "commonjs",
    "target": "es2018",
    "types": ["node"],          // 👈 これを追加
    "strict": false,            // 👈 false にするか、"strictNullChecks": false に変更
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  }
}
